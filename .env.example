# Copy to .env and adjust. Every variable is optional except the model endpoint.

# ── Model: any OpenAI-compatible endpoint, base URL including /v1 ──
# Ollama:        http://localhost:11434/v1        (set EARNIQ_LLM_MODEL, e.g. qwen3:30b-a3b)
# LM Studio:     http://localhost:1234/v1
# llama.cpp:     http://localhost:8080/v1
# mlx_lm.server: http://localhost:8080/v1
# From Docker to a model on the host: http://host.docker.internal:11434/v1
EARNIQ_LLM_BASE_URL=http://localhost:11434/v1
EARNIQ_LLM_MODEL=
# EARNIQ_LLM_API_KEY=            # or EARNIQ_LLM_API_KEY_FILE=/run/secrets/llm_key
# EARNIQ_LLM_TIMEOUT=300
# EARNIQ_SUMMARY_LANGUAGE=English

# ── Storage ──
# EARNIQ_DATA_DIR=./data

# ── Fetching ──
# EARNIQ_CHROMIUM=/usr/bin/chromium   # found automatically if empty
# EARNIQ_BROWSER_WAIT_MS=8000
# EARNIQ_BROWSER_TIMEOUT=90
# EARNIQ_ACCEPT_LANGUAGE=en-US,en;q=0.9
# SEC EDGAR requires name and contact, e.g. "Jane Doe jane@example.com".
# Only sent to sec.gov. Without it, past earnings dates from 8-K filings are skipped.
# EARNIQ_SEC_USER_AGENT=

# ── Alerts ──
# EARNIQ_ALERT_WEBHOOK_URL=https://ntfy.sh/your-secret-topic
# EARNIQ_ALERT_FORMAT=ntfy           # json | ntfy | slack | discord
# EARNIQ_ALERT_MAX_PER_DAY=8

# ── Web interface ──
# No user management. Keep it on a private network, or set a login:
# EARNIQ_BASIC_AUTH=user:a-long-password
# Load the example watchlist and monitors on first start:
# EARNIQ_SEED_EXAMPLES=1
